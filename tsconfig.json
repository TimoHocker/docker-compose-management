{
  "compilerOptions": {
    "module": "commonjs",
    "rootDir": "./lib",
    "outDir": "./dist",
    "strict": true, 
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "lib/**/*.ts",
    "test/**/*.ts"
  ]
}
